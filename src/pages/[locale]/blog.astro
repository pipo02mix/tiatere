---
import Layout from "../../layouts/Layout.astro";
import { localePaths, useTranslations } from "../../i18n.js";
import { excerpt, formatDate, getListedPosts } from "../../medium.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);
const entries = await getListedPosts(3);
---
<Layout locale={locale} title={t("blog")}>
    <h1>Blog</h1>
    {entries.map((entry) => (
        <div class="blog-entry">
            <h3><a href={`/${locale}/blog/${entry.slug}`}>{entry.title}</a></h3>
            <p> <icon class="icon icon-time"></icon>&nbsp; {formatDate(entry.date)}</p>
            <p set:html={excerpt(entry.content)} />
        </div>
    ))}
</Layout>
