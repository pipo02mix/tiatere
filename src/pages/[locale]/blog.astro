---
import Layout from "../../layouts/Layout.astro";
import { localePaths, useTranslations } from "../../i18n.js";
import { formatDate, getPosts } from "../../blog.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);
const entries = await getPosts();
---
<Layout locale={locale} title={t("blog")}>
    <h1>Blog</h1>
    {entries.map((entry) => (
        <div class="blog-entry">
            <h3><a href={`/${locale}/blog/${entry.id}`}>{entry.data.title}</a></h3>
            <p class="meta">{formatDate(entry.data.date)}</p>
            <p>{entry.data.description}</p>
        </div>
    ))}
</Layout>
