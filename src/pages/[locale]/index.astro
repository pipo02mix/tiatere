---
import Layout from "../../layouts/Layout.astro";
import { localePaths, useTranslations } from "../../i18n.js";
import { formatDate, getListedPosts } from "../../medium.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);
const entries = await getListedPosts(3);
---
<Layout locale={locale}>
    <h1>{t("home_headline")}</h1>
    <p>{t("home_intro")}</p>

    <h2 class="section-label">{t("latest_posts")}</h2>
    <div class="post-list">
        {entries.map((entry) => (
            <a href={`/${locale}/blog/${entry.slug}`}>
                <span class="post-list-title">{entry.title}</span>
                <span class="meta">{formatDate(entry.date)}</span>
            </a>
        ))}
    </div>
    <a href={`/${locale}/blog`}>{t("all_posts")}</a>

    <h2 class="section-label">{t("tiatere_why")}</h2>
    <p class="quote">{t("tiatere_why_explanation")}</p>
</Layout>
