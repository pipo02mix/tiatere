---
import Layout from "../../layouts/Layout.astro";
import { localePaths, useTranslations } from "../../i18n.js";
import { education, experience } from "../../resume.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);
const text = (value) => (typeof value === "string" ? value : value[locale]);
const sections = [
    { label: t("experience"), entries: experience },
    { label: t("education"), entries: education },
];
---
<Layout locale={locale} title={t("curriculum")}>
    <h1>{t("curriculum")}</h1>
    <button type="button" class="btn no-print" onclick="window.print()">{t("download_pdf")}</button>
    {sections.map((section) => (
        <>
            <h2 class="section-label">{section.label}</h2>
            <ol class="resume">
                {section.entries.map((entry) => (
                    <li>
                        <p class="meta">{text(entry.period)}</p>
                        <h3>{text(entry.title)}</h3>
                        <p class="resume-org">{entry.org}</p>
                        {entry.description && <p class="resume-description">{text(entry.description)}</p>}
                    </li>
                ))}
            </ol>
        </>
    ))}
</Layout>
