---
import Layout from "../../layouts/Layout.astro";
import { localePaths, useTranslations } from "../../i18n.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);
---
<Layout locale={locale} title={t("about-me")}>
    <h1>Fernando Ripoll Lafuente</h1>
    <p>{t("aboutme")}</p>
    <h2 class="section-label">{t("tiatere_why")}</h2>
    <p class="quote">{t("tiatere_why_explanation")}</p>
</Layout>
