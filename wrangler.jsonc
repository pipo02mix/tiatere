{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiatere",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Browser navigations to a path without an asset get the 404 page
    // without reaching the Worker, so the paths it handles go to it first.
    "run_worker_first": ["/", "/es/about-me", "/en/about-me", "/api/*"]
  }
}
